    color: var(--color-text-secondary);
    text-align: center;
    max-width: 60ch;
  }
</style>

<script>
  function setupLightbox() {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.querySelector('.lightbox-close');
    const backdrop = document.querySelector('.lightbox-backdrop');

    if (!lightbox || !lightboxImg || !lightboxCaption) return;

    const openLightbox = (src: string, caption: string) => {
      if (!src) return;
      lightboxImg.src = src;
      lightboxImg.alt = caption;
      lightboxCaption.textContent = caption;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!lightbox.classList.contains('is-open')) {
          lightboxImg.src = '';
        }
      }, 250);
    };

    document.querySelectorAll('.js-lightbox-trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-img-src');
        const caption = trigger.getAttribute('data-img-caption') || '';
        if (src) openLightbox(src, caption);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    backdrop?.addEventListener('click', closeLightbox);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.classList.contains('is-open')) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('astro:page-load', setupLightbox);

  // ── Back to Top ──────────────────────────────────────────────
  function setupBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const THRESHOLD = 400;

    const toggle = () => {
      const scrollY = window.scrollY || document.documentElement.scrollTop;
      btn.classList.toggle('is-visible', scrollY > THRESHOLD);
    };

    window.addEventListener('scroll', toggle, { passive: true });
    toggle(); // initial check

    btn.addEventListener('click', () => {
      // Use Lenis if available, otherwise native smooth scroll
      const lenis = (window as any)._lenis;
      if (lenis && typeof lenis.scrollTo === 'function') {
        lenis.scrollTo(0, { duration: 1.2, easing: (t: number) => 1 - Math.pow(1 - t, 4) });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // ── Scroll-to-Embed (View Prototype / View Design buttons) ───
  function setupScrollToEmbed() {
    document.querySelectorAll('.js-scroll-to-embed').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.getElementById('design-embed');
        if (!target) return;
        const offset = target.getBoundingClientRect().top + window.scrollY - 100;
        const lenis = (window as any)._lenis;
        if (lenis && typeof lenis.scrollTo === 'function') {
          lenis.scrollTo(target, { offset: -100, duration: 1.2, easing: (t: number) => 1 - Math.pow(1 - t, 4) });
        } else {
          window.scrollTo({ top: offset, behavior: 'smooth' });
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupBackToTop);
  document.addEventListener('astro:page-load', setupScrollToEmbed);

  // ── Embed Tab Switcher ─────────────────────────────────────────
  function setupEmbedTabs() {
    const iframe = document.getElementById('design-embed-iframe') as HTMLIFrameElement | null;
    if (!iframe) return;
    document.querySelectorAll('.embed-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        const src = tab.getAttribute('data-embed-src');
        if (!src) return;
        iframe.src = src;
        document.querySelectorAll('.embed-tab').forEach((t) => t.classList.remove('is-active'));
        tab.classList.add('is-active');
      });
    });
  }
  document.addEventListener('astro:page-load', setupEmbedTabs);
</script>

