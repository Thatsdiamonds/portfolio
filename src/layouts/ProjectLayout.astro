---
import BaseLayout from './BaseLayout.astro';
import T from '../components/T.astro';
import { SITE_CONFIG } from '../config';

interface ImageItemObject {
  src: string;
  caption?: { en: string; id: string };
  alt?: { en: string; id: string };
}

interface Props {
  project: {
    slug: string;
    data: {
      title?: { en: string; id: string };
      description?: { en: string; id: string };
      year?: number;
      role?: { en: string; id: string };
      category?: string;
      technologies?: string[];
      featured?: boolean;
      image?: string;
      hero_image?: string;
      context_image?: string;
      solution_image?: string;
      github?: string;
      url?: string;
      prototype_url?: string;
      design_url?: string;
      source_url?: string;
      embed_url?: string;
      prototype_url_admin?: string;
      embed_url_admin?: string;
      competition?: { en: string; id: string };
      period?: string;
      tools?: string[];
      context?: { en: string; id: string };
      problem?: { en: string; id: string };
      solution?: { en: string; id: string };
      outcome?: { en: string; id: string };
      challenges?: { en: string; id: string };
      lessons_learned?: { en: string; id: string };
      technical_details?: {
        architecture?: string;
        database_strategy?: string;
        deployment_method?: string;
        key_implementations?: string[];
      };
      metrics?: Record<string, string>;
      gallery_images?: (string | ImageItemObject)[];
      metadata?: Record<string, any>;
      content?: Record<string, any>;
      order?: number;
    };
  };
  nextProject?: {
    slug: string;
    data: { title: { en: string; id: string }; category?: string };
  } | null;
}

const { project, nextProject } = Astro.props;
const d = project.data;

const formatMetricKey = (key: string) => {
  return key
    .replace(/_/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
};

const resolveImgPath = (src?: string) => {
  if (!src) return '';
  if (src.startsWith('http://') || src.startsWith('https://') || src.startsWith('/')) {
    return src;
  }
  return `/projects/${src}`;
};

const bannerImage = resolveImgPath(d.hero_image || d.image);
const contextImage = resolveImgPath(d.context_image);
const solutionImage = resolveImgPath(d.solution_image);

const parsedGallery = (d.gallery_images || []).map((item) => {
  if (typeof item === 'string') {
    const cleanName = item.replace(/\.[^/.]+$/, '');
    const label = formatMetricKey(cleanName);
    return {
      src: resolveImgPath(item),
      captionEn: label,
      captionId: label,
      altEn: label,
      altId: label,
    };
  }
  const fallbackLabel = formatMetricKey(item.src.replace(/\.[^/.]+$/, ''));
  return {
    src: resolveImgPath(item.src),
    captionEn: item.caption?.en || fallbackLabel,
    captionId: item.caption?.id || fallbackLabel,
    altEn: item.alt?.en || fallbackLabel,
    altId: item.alt?.id || fallbackLabel,
  };
});
const titleEn = d.title?.en || d.metadata?.title?.en || 'Project';
const titleId = d.title?.id || d.metadata?.title?.id || titleEn;
const descEn = d.description?.en || d.metadata?.subtitle?.en || d.content?.overview?.en || '';
const descId = d.description?.id || d.metadata?.subtitle?.id || d.content?.overview?.id || descEn;
---

<BaseLayout
  title={`${titleEn} - ${SITE_CONFIG.name}`}
  description={descEn}
  preloadImage={bannerImage}
>
  <article class="case-study-page">
    <!-- Top Hero Banner Image -->
    <div class="case-banner container">
      <div class="case-banner__frame js-lightbox-trigger" data-img-src={bannerImage} data-img-caption={titleEn}>
        {bannerImage ? (
          <img src={bannerImage} alt={titleEn} fetchpriority="high" class="case-banner__img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
        ) : null}
        <div class="case-banner__placeholder" style={bannerImage ? 'display: none;' : ''}>
          <span class="meta">
            <span class="t-en">{titleEn}</span>
            <span class="t-id">{titleId}</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Case Study Header -->
    <header class="case-header container container--narrow">
      <h1 class="case-title display">
        <span class="t-en">{titleEn}</span>
        <span class="t-id">{titleId}</span>
      </h1>

      <p class="case-abstract meta">
        <span class="t-en">{descEn}</span>
        <span class="t-id">{descId}</span>
      </p>

      <!-- Meta Row & Action Buttons -->
      <div class="case-meta-row meta">
        <div class="meta-item">
          <span class="meta-label">Category:</span>
          <span>{d.category || d.metadata?.category}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Role:</span>
          <span>
            <span class="t-en">{d.role?.en || d.metadata?.role?.en}</span>
            <span class="t-id">{d.role?.id || d.metadata?.role?.id}</span>
          </span>
        </div>
        {(d.year || d.period || d.metadata?.period) && (
          <div class="meta-item">
            <span class="meta-label">Timeline:</span>
            <span>{d.period || d.metadata?.period || d.year}</span>
          </div>
        )}
      </div>

      <!-- Action Buttons Row (Live, Prototype, Design, GitHub, Drive Source) -->
      {(d.url || d.github || d.prototype_url || d.design_url || d.source_url) && (
        <div class="case-actions-row">
          {d.prototype_url && (
            d.embed_url ? (
              <a href="#design-embed" class="case-action-btn case-action-btn--primary js-scroll-to-embed">
                <span class="t-en">View Prototype ↓</span>
                <span class="t-id">Lihat Prototipe ↓</span>
              </a>
            ) : (
              <a href={d.prototype_url} target="_blank" rel="noopener noreferrer" class="case-action-btn case-action-btn--primary">
                <span class="t-en">View Prototype ↗</span>
                <span class="t-id">Lihat Prototipe ↗</span>
              </a>
            )
          )}
          {d.design_url && (
            d.embed_url ? (
              <a href="#design-embed" class="case-action-btn js-scroll-to-embed">
                <span class="t-en">View Full Design ↓</span>
                <span class="t-id">Lihat Desain Lengkap ↓</span>
              </a>
            ) : (
              <a href={d.design_url} target="_blank" rel="noopener noreferrer" class="case-action-btn">
                <span class="t-en">View Design ↗</span>
                <span class="t-id">Lihat Desain ↗</span>
              </a>
            )
          )}
          {d.source_url && (
            <a href={d.source_url} target="_blank" rel="noopener noreferrer" class="case-action-btn">
              <span class="t-en">Project Source ↗</span>
              <span class="t-id">Sumber Proyek ↗</span>
            </a>
          )}
          {d.url && (
            <a href={d.url} target="_blank" rel="noopener noreferrer" class="case-action-btn">
              {d.url.includes('itch.io') ? (
                <>
                  <span class="t-en">Itch.io Submission ↗</span>
                  <span class="t-id">Misi Itch.io ↗</span>
                </>
              ) : (
                <>
                  <span class="t-en">Live System ↗</span>
                  <span class="t-id">Sistem Live ↗</span>
                </>
              )}
            </a>
          )}
          {d.github && (
            <a href={d.github} target="_blank" rel="noopener noreferrer" class="case-action-btn">
              <span>GitHub ↗</span>
            </a>
          )}
        </div>
      )}

      <!-- Competition & Award Badge (if available) -->
      {(d.competition || d.metadata?.competition) && (
        <div class="case-award-badge meta">
          <span>
            <span class="t-en">{(d.competition || d.metadata?.competition).en}</span>
            <span class="t-id">{(d.competition || d.metadata?.competition).id}</span>
          </span>
        </div>
      )}

      <!-- Tech Stack Badges -->
      {((d.technologies && d.technologies.length > 0) || (d.metadata?.tools && d.metadata?.tools.length > 0)) && (
        <div class="case-tech-stack">
          {(d.technologies.length > 0 ? d.technologies : d.metadata?.tools || []).map((tech: string) => (
            <span class="tech-pill">{tech}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Key Metrics Highlight Section (if available) -->
    {d.metrics && Object.keys(d.metrics).length > 0 && (
      <section class="case-metrics container container--narrow">
        <div class="metrics-grid">
          {Object.entries(d.metrics).map(([key, value]) => (
            <div class="metric-card">
              <span class="metric-value">{value}</span>
              <span class="metric-label">{formatMetricKey(key)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Case Study Body Sections -->
    <main class="case-body container container--narrow">
      <!-- Section 1: Background / Overview -->
      {(d.context || d.content?.overview) && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">1. Background & Overview</span>
            <span class="t-id">1. Latar Belakang & Ringkasan</span>
          </h2>
          <p class="case-prose meta">
            <span class="t-en">{d.context?.en || d.content?.overview?.en}</span>
            <span class="t-id">{d.context?.id || d.content?.overview?.id}</span>
          </p>

          {contextImage && (
            <div class="case-inline-media">
              <div class="inline-media__frame js-lightbox-trigger" data-img-src={contextImage} data-img-caption="Context Overview">
                <img src={contextImage} alt="Context Overview" class="inline-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="inline-placeholder" style="display: none;"><span class="meta">Context Overview Diagram</span></div>
              </div>
            </div>
          )}
        </section>
      )}

      <!-- Section 2: Problem Statement & Challenge -->
      {(d.problem || d.content?.problem_statement) && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">2. The Problem & Challenge</span>
            <span class="t-id">2. Masalah & Tantangan Utama</span>
          </h2>
          <p class="case-prose meta">
            <span class="t-en">{d.problem?.en || d.content?.problem_statement?.en}</span>
            <span class="t-id">{d.problem?.id || d.content?.problem_statement?.id}</span>
          </p>
        </section>
      )}

      <!-- Section 2.5: User Persona & Research (if available in content.target_user) -->
      {d.content?.target_user && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">Target User & Persona</span>
            <span class="t-id">Target Pengguna & Persona</span>
          </h2>
          <div class="persona-card">
            <div class="persona-header">
              <div>
                <h3 class="persona-name">{d.content.target_user.name}, {d.content.target_user.age}</h3>
                <p class="meta persona-role">{d.content.target_user.occupation} · {d.content.target_user.location}</p>
              </div>
            </div>
            <div class="persona-grid">
              <div class="persona-col">
                <h4 class="persona-subheading">Goals & Objectives</h4>
                <ul class="persona-list">
                  {d.content.target_user.goals?.map((g: string) => (
                    <li>{g}</li>
                  ))}
                </ul>
              </div>
              <div class="persona-col">
                <h4 class="persona-subheading">Frustrations & Pain Points</h4>
                <ul class="persona-list persona-list--pain">
                  {d.content.target_user.pain_points?.map((p: string) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Section 3: Solution, Process & Key Features -->
      {(d.solution || d.content?.design_process || d.content?.key_features) && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">3. Solution & Design Process</span>
            <span class="t-id">3. Solusi & Proses Desain</span>
          </h2>
          {d.solution && (
            <p class="case-prose meta">
              <span class="t-en">{d.solution.en}</span>
              <span class="t-id">{d.solution.id}</span>
            </p>
          )}

          {solutionImage && (
            <div class="case-inline-media">
              <div class="inline-media__frame js-lightbox-trigger" data-img-src={solutionImage} data-img-caption="Solution Workflow">
                <img src={solutionImage} alt="Solution Workflow" class="inline-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="inline-placeholder" style="display: none;"><span class="meta">Solution Workflow Diagram</span></div>
              </div>
            </div>
          )}

          <!-- Design Principles (if available) -->
          {d.content?.design_process?.principles_applied && (
            <div class="principles-grid">
              {d.content.design_process.principles_applied.map((principle: any) => (
                <div class="principle-card">
                  <span class="principle-title">{principle.law}</span>
                  <p class="principle-desc meta">{principle.application}</p>
                </div>
              ))}
            </div>
          )}

          <!-- Key Features (if available) -->
          {d.content?.key_features && (
            <div class="key-features-container">
              <h3 class="tech-details-title" style="margin-bottom: var(--space-4);">
                <span class="t-en">Key Features Breakdown</span>
                <span class="t-id">Rincian Fitur Utama</span>
              </h3>
              <div class="features-grid">
                {d.content.key_features.map((feature: any) => (
                  <div class="feature-item-card">
                    <h4 class="feature-name">{feature.name}</h4>
                    <p class="feature-desc meta">{feature.description}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Technical Details Card (if available) -->
          {d.technical_details && (
            <div class="tech-details-card">
              <h3 class="tech-details-title">
                <span class="t-en">Technical Specifications</span>
                <span class="t-id">Spesifikasi Teknis</span>
              </h3>
              
              <div class="tech-spec-grid">
                {d.technical_details.architecture && (
                  <div class="tech-spec-item">
                    <span class="tech-spec-label">Architecture</span>
                    <span class="tech-spec-val">{d.technical_details.architecture}</span>
                  </div>
                )}
                {d.technical_details.database_strategy && (
                  <div class="tech-spec-item">
                    <span class="tech-spec-label">Database Strategy</span>
                    <span class="tech-spec-val">{d.technical_details.database_strategy}</span>
                  </div>
                )}
                {d.technical_details.deployment_method && (
                  <div class="tech-spec-item">
                    <span class="tech-spec-label">Deployment Method</span>
                    <span class="tech-spec-val">{d.technical_details.deployment_method}</span>
                  </div>
                )}
              </div>

              {d.technical_details.key_implementations && d.technical_details.key_implementations.length > 0 && (
                <div class="key-implementations">
                  <span class="key-impl-label">Key Implementations:</span>
                  <ul class="key-impl-list">
                    {d.technical_details.key_implementations.map((impl: string) => (
                      <li class="key-impl-item">{impl}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
        </section>
      )}

      <!-- Section 4: Outcome & Impact -->
      {(d.outcome || d.content?.outcome) && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">4. Outcome & Impact</span>
            <span class="t-id">4. Hasil & Dampak</span>
          </h2>
          <p class="case-prose meta">
            <span class="t-en">{d.outcome?.en || d.content?.outcome?.en}</span>
            <span class="t-id">{d.outcome?.id || d.content?.outcome?.id}</span>
          </p>
        </section>
      )}

      <!-- Section 5: Challenges & Lessons Learned -->
      {(d.challenges || d.lessons_learned) && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">5. Challenges & Lessons Learned</span>
            <span class="t-id">5. Tantangan & Pembelajaran</span>
          </h2>
          
          {d.challenges && (
            <div class="case-subblock">
              <h3 class="case-subtitle">
                <span class="t-en">Engineering Challenges</span>
                <span class="t-id">Tantangan Rekayasa</span>
              </h3>
              <p class="case-prose meta">
                <span class="t-en">{d.challenges.en}</span>
                <span class="t-id">{d.challenges.id}</span>
              </p>
            </div>
          )}

          {d.lessons_learned && (
            <div class="case-subblock">
              <h3 class="case-subtitle">
                <span class="t-en">Key Takeaways</span>
                <span class="t-id">Pelajaran Berharga</span>
              </h3>
              <p class="case-prose meta">
                <span class="t-en">{d.lessons_learned.en}</span>
                <span class="t-id">{d.lessons_learned.id}</span>
              </p>
            </div>
          )}
        </section>
      )}

      <!-- Section 6: Gallery & Screenshots -->
      {parsedGallery.length > 0 && (
        <section class="case-section">
          <h2 class="case-section__title">
            <span class="t-en">Interface & System Views</span>
            <span class="t-id">Tampilan Antarmuka & Sistem</span>
          </h2>
          <div class="case-gallery-grid">
            {parsedGallery.map((img) => (
              <figure class="gallery-figure">
                <div class="gallery-frame js-lightbox-trigger" data-img-src={img.src} data-img-caption={img.captionEn}>
                  <img
                    src={img.src}
                    alt={img.altEn}
                    loading="lazy"
                    decoding="async"
                    class="gallery-img"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                  <div class="gallery-placeholder" style="display: none;">
                    <span class="meta">
                      <span class="t-en">{img.captionEn}</span>
                      <span class="t-id">{img.captionId}</span>
                    </span>
                  </div>
                </div>
                <figcaption class="gallery-caption meta">
                  <span class="t-en">{img.captionEn}</span>
                  <span class="t-id">{img.captionId}</span>
                </figcaption>
              </figure>
            ))}
          </div>

          {/* Figma / Design Embed - supports dual User + Admin flows */}
          {(d.embed_url || d.embed_url_admin) && (
            <div id="design-embed" class="design-embed-section">
              <div class="design-embed-header">
                <span class="design-embed-label meta">
                  <span class="t-en">Interactive Design Preview</span>
                  <span class="t-id">Pratinjau Desain Interaktif</span>
                </span>
                <div class="design-embed-actions">
                  {/* Tab switcher - only shown when both flows exist */}
                  {d.embed_url && d.embed_url_admin && (
                    <div class="embed-tab-group">
                      <button class="embed-tab is-active" data-embed-src={d.embed_url} id="embed-tab-user">
                        <span class="t-en">User Flow</span>
                        <span class="t-id">Flow Pengguna</span>
                      </button>
                      <button class="embed-tab" data-embed-src={d.embed_url_admin} id="embed-tab-admin">
                        <span class="t-en">Admin Flow</span>
                        <span class="t-id">Flow Admin</span>
                      </button>
                    </div>
                  )}
                  {/* Open-external links */}
                  {d.prototype_url && (
                    <a href={d.prototype_url} target="_blank" rel="noopener noreferrer" class="embed-action-link">
                      <span class="t-en">{d.prototype_url_admin ? 'Open User Prototype ↗' : 'Open Prototype ↗'}</span>
                      <span class="t-id">{d.prototype_url_admin ? 'Buka Prototipe Pengguna ↗' : 'Buka Prototipe ↗'}</span>
                    </a>
                  )}
                  {d.prototype_url_admin && (
                    <a href={d.prototype_url_admin} target="_blank" rel="noopener noreferrer" class="embed-action-link">
                      <span class="t-en">Open Admin Prototype ↗</span>
                      <span class="t-id">Buka Prototipe Admin ↗</span>
                    </a>
                  )}
                  {d.design_url && (
                    <a href={d.design_url} target="_blank" rel="noopener noreferrer" class="embed-action-link">
                      <span class="t-en">Open in Figma ↗</span>
                      <span class="t-id">Buka di Figma ↗</span>
                    </a>
                  )}
                </div>
              </div>
              <div class="design-embed-frame">
                <iframe
                  src={d.embed_url || d.embed_url_admin}
                  allowfullscreen
                  loading="lazy"
                  title={titleEn + ' - Design Preview'}
                  class="design-embed-iframe"
                  id="design-embed-iframe"
                />
              </div>
            </div>
          )}
        </section>
      )}

      <slot />
    </main>

    {/* Back to Top Button */}
    <button id="back-to-top" class="back-to-top" aria-label="Back to top">
      <span class="back-to-top__inner">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
      </span>
      <span class="back-to-top__label">
        <span class="t-en">Back to top</span>
        <span class="t-id">Ke atas</span>
      </span>
    </button>

    <!-- Image Lightbox Modal -->
    <div id="image-lightbox" class="image-lightbox" aria-hidden="true" role="dialog">
      <div class="lightbox-backdrop"></div>
      <div class="lightbox-container">
        <button class="lightbox-close" aria-label="Close Lightbox">✕</button>
        <img id="lightbox-img" src="" alt="" class="lightbox-img" />
        <p id="lightbox-caption" class="lightbox-caption meta"></p>
      </div>
    </div>

    <!-- Next Case Study -->
    {nextProject && (
      <nav class="case-next container container--narrow" aria-label="Next Case Study">
        <div class="next-divider"></div>
        <p class="meta" style="margin-bottom: var(--space-2); color: var(--color-text-muted);">Next project</p>
        <a href={`/projects/${nextProject.slug}`} class="next-link">
          <h3 class="next-title">
            <span class="t-en">{nextProject.data.title?.en || nextProject.data.metadata?.title?.en}</span>
            <span class="t-id">{nextProject.data.title?.id || nextProject.data.metadata?.title?.id}</span>
            <span class="next-arrow" aria-hidden="true"> →</span>
          </h3>
        </a>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .case-study-page {
    padding-top: calc(4rem + var(--space-12));
    padding-bottom: var(--space-32);
  }

  /* Top Banner Image */
  .case-banner {
    margin-bottom: var(--space-12);
  }

  .case-banner__frame {
    width: 100%;
    aspect-ratio: 21 / 9;
    background: var(--color-bg-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .case-banner__frame {
      aspect-ratio: 16 / 10;
    }
  }

  .case-banner__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-banner__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  /* Header */
  .case-header {
    margin-bottom: var(--space-16);
  }

  .case-title {
