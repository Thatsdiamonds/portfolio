---
import T from './T.astro';
import { SITE_CONFIG } from '../config';
---

<header class="site-header" id="site-header" role="banner">
  <div class="site-header__inner container">
    <!-- Left Logo / Brand -->
    <a href="/" class="site-header__brand" aria-label="Home">
      <span class="brand-name">{SITE_CONFIG.name}</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="site-header__nav" aria-label="Main Navigation">
      <ul class="site-header__links" role="list">
        <li>
          <a href="/projects" class="nav-link">
            <span class="t-en">selected work</span>
            <span class="t-id">karya</span>
          </a>
        </li>
        <li>
          <a href="/about" class="nav-link">
            <T keyName="nav.about" />
          </a>
        </li>
        <li>
          <a href="/resume" class="nav-link">
            <T keyName="nav.resume" />
          </a>
        </li>
      </ul>

      <!-- Language Pill Toggle -->
      <div class="lang-switch-wrap">
        <button
          type="button"
          class="lang-pill"
          id="lang-toggle-btn"
          aria-label="Toggle language between English and Indonesian"
        >
          <span class="t-en">EN / ID</span>
          <span class="t-id">ID / EN</span>
        </button>
      </div>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      class="site-header__menu-btn"
      id="menu-btn"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle menu"
    >
      <span class="hamburger-box" aria-hidden="true">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </span>
    </button>
  </div>

  <!-- Mobile menu overlay -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="mobile-menu__inner container">
      <nav aria-label="Mobile Navigation">
        <ul class="mobile-menu__links" role="list">
          <li>
            <a href="/projects" class="mobile-nav-link">
              <span class="t-en">selected work</span>
              <span class="t-id">karya</span>
            </a>
          </li>
          <li>
            <a href="/about" class="mobile-nav-link"><T keyName="nav.about" /></a>
          </li>
          <li>
            <a href="/resume" class="mobile-nav-link"><T keyName="nav.resume" /></a>
          </li>
        </ul>
      </nav>

      <div class="mobile-menu__footer">
        <button
          type="button"
          class="pill-btn pill-btn--outline mobile-lang-btn"
          id="mobile-lang-toggle-btn"
        >
          <span class="t-en">Bahasa Indonesia</span>
          <span class="t-id">English</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(18, 18, 18, 0.85);
    backdrop-filter: blur(12px);
    transition: border-color var(--duration-base);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled {
    border-bottom-color: var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: var(--space-8);
  }

  .site-header__links {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-link {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--color-text-secondary);
    text-transform: lowercase;
    transition: color var(--duration-fast);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text);
  }

  .lang-pill {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.65rem;
    cursor: pointer;
    font-size: var(--text-2xs);
    font-weight: 600;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    transition: all var(--duration-fast);
  }
  .lang-pill:hover {
    border-color: var(--color-text-secondary);
    background-color: var(--color-bg-elevated);
  }

  /* Mobile menu button */
  .site-header__menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    cursor: pointer;
    color: var(--color-text);
    border-radius: var(--radius-xs);
  }

  .hamburger-box {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 16px;
  }

  .hamburger-line {
    display: block;
    height: 1.5px;
    width: 100%;
    background-color: currentColor;
    transition: transform var(--duration-base) var(--ease-out);
  }

  /* Mobile overlay */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 4rem 0 0 0;
    background-color: var(--color-bg);
    z-index: 99;
    border-top: 1px solid var(--color-border);
    padding: var(--space-8);
  }
  .mobile-menu.is-open {
    display: block;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mobile-nav-link {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text);
    text-transform: lowercase;
  }

  @media (min-width: 768px) {
    .site-header__nav { display: flex; }
    .site-header__menu-btn { display: none; }
  }
</style>

<script>
  const initHeader = () => {
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      header?.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });

    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn?.addEventListener('click', () => {
      const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isOpen));
      mobileMenu?.classList.toggle('is-open', !isOpen);
      mobileMenu?.setAttribute('aria-hidden', String(isOpen));
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    mobileMenu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menuBtn?.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('is-open');
        mobileMenu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });

    const handleToggle = () => {
      const isEn = document.documentElement.classList.contains('lang-en');
      const newLang = isEn ? 'id' : 'en';
      localStorage.setItem('portfolio-lang', newLang);
      document.documentElement.className = 'lang-' + newLang;
      window.dispatchEvent(new CustomEvent('lang-changed', { detail: newLang }));
    };

    document.getElementById('lang-toggle-btn')?.addEventListener('click', handleToggle);
    document.getElementById('mobile-lang-toggle-btn')?.addEventListener('click', handleToggle);

    // Active link highlighting
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.nav-link, .mobile-nav-link').forEach((link) => {
      const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';
      if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
